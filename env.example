# Platform API Configuration
# Platform backend API address
PLATFORM_API_BASE=http://localhost:8001

# API Timeout (seconds)
# API request timeout in seconds
API_TIMEOUT=30.0

# Authentication
# Authentication configuration - Fill in after generating API Key on platform
# How to get: Visit PLATFORM_API_BASE/auth/login to login and create
PLATFORM_API_KEY=mcp_key_your_api_key_here

# Logging
# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
# Feature toggles
ENABLE_CACHING=true
CACHE_TTL=300

